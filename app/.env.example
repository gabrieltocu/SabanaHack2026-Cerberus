# Copia este archivo a .env y completa los valores. El .env real no se versiona.
# Genera cada valor con:  openssl rand -base64 32
CERBERUS_JWT_SECRET=
CERBERUS_BOT_KEY=
CERBERUS_QR_SECRET=
CERBERUS_PHOTO_KEY=
# Solo para HTTPS con Caddy (docker compose --profile https up -d). Déjalo vacío si usas la IP.
DOMAIN=

# Integración con el padrón de SABANAHACK (sin actividades, turnos ni órdenes de ejemplo).
# CERBERUS_DATA_SOURCE=sabana
CERBERUS_TEAM_PASSWORD=
