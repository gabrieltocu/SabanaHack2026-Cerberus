{
  "name": "cerberus-nogal",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/bodoni-moda": "^0.4.2",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.19",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.10",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.12",
    "js-yaml": "^4.3.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "expo start --web",
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "git ls-files -z -co --exclude-standard | xargs -0 prettier --write --ignore-unknown",
    "format:check": "git ls-files -z -co --exclude-standard | xargs -0 prettier --check --ignore-unknown",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "build:web": "expo export -p web",
    "build:web:api": "EXPO_PUBLIC_DATA_MODE=api expo export -p web --output-dir dist-api",
    "serve": "tsx scripts/serve.ts",
    "test:e2e": "playwright test",
    "verify": "npm run check:secrets && npm run check:audit && npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:integration && npm run build:web && npm run build:web:api && npm run test:e2e",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "check:audit": "node scripts/audit.mjs",
    "test:smoke": "playwright test -c playwright.smoke.config.ts"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
